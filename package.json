{
  "name": "meerkat",
  "version": "0.1.0",
  "private": true,
  "description": "Meerkat: one command that checks an app before a push, a promotion or a build.",
  "engines": { "node": ">=20" },
  "scripts": {
    "meerkat": "node run.mjs",
    "meerkat:thorough": "node run.mjs --thorough",
    "meerkat:doctor": "node doctor.mjs",
    "meerkat:promotion": "node promotion-due.mjs",
    "meerkat:watch": "node watch.mjs",
    "preview": "node preview.mjs --speed 6",
    "preview:head": "node preview.mjs --head",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
