{
  "name": "@samuelndce/meerkat",
  "version": "0.5.3",
  "description": "A scanner for people, and a tool and scaffolding for AIs, to check, map and test a project: security, correctness, accessibility, performance and code health. Works standalone without AI and does more with AI (MCP). Zero dependencies, no telemetry.",
  "keywords": [
    "verdict",
    "branch-check",
    "code-review",
    "static-analysis",
    "lint",
    "security",
    "ai-agents",
    "mcp",
    "code-map",
    "pre-commit",
    "pre-push",
    "cli",
    "ci",
    "sarif",
    "accessibility",
    "developer-tools"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "SamuelNDCE",
  "homepage": "https://github.com/SamuelNDCE/Meerkat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelNDCE/Meerkat.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelNDCE/Meerkat/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "meerkat": "bin/meerkat.mjs",
    "meerkat-mcp": "bin/meerkat-mcp.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "packs/",
    "thorough/",
    "profiles/",
    "skills/",
    "fixtures/",
    "examples/",
    "run.mjs",
    "meerkat.config.json",
    "llms.txt",
    "CHANGELOG.md",
    "!**/*.test.ts",
    "!**/target/**",
    "!**/node_modules/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "meerkat": "node run.mjs",
    "meerkat:thorough": "node run.mjs --thorough",
    "meerkat:watch": "node tools/watch.mjs",
    "preview": "node tools/preview.mjs --speed 6",
    "test": "vitest run",
    "test:accuracy": "node tools/test-accuracy.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
